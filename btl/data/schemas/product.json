{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "product_name": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "subcategory": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "enum": [
        "VND",
        "USD"
      ]
    },
    "rating": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5.0
    },
    "review_count": {
      "type": "integer",
      "minimum": 0
    },
    "seller": {
      "type": "string"
    },
    "product_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "product_id",
    "product_name",
    "brand",
    "category",
    "price",
    "currency",
    "source"
  ]
}