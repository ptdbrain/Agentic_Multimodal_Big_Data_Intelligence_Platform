{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 5.0
    },
    "review_title": {
      "type": "string"
    },
    "review_text": {
      "type": "string",
      "minLength": 1
    },
    "review_date": {
      "type": "string"
    },
    "verified_purchase": {
      "type": "boolean"
    },
    "helpful_count": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "vi",
        "en"
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "product_id",
    "user_id",
    "rating",
    "review_title",
    "review_text",
    "review_date"
  ]
}