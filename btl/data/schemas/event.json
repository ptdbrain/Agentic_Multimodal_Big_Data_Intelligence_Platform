{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "NEW_REVIEW",
        "NEW_PRODUCT",
        "PRICE_UPDATE",
        "RATING_UPDATE",
        "PRODUCT_UPDATE",
        "EVENT"
      ]
    },
    "product_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "product_id",
    "timestamp",
    "payload"
  ]
}