{
  "uid": "sentinel-datasets",
  "title": "Sentinel · Từng nguồn dữ liệu",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "sentinel",
    "datasets"
  ],
  "description": "Số liệu từ từng schema/bucket trong registry. Thiếu receipt giữ trạng thái chưa xác định. Đếm bản ghi có provenance đúng nguồn; không hợp nhất nguồn giả lập với dữ liệu quan sát.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kết nối SQL từng nguồn",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_dataset_up{dataset_id=~\"${dataset:regex}\"}",
          "instant": true,
          "legendFormat": "{{dataset_id}} {{entity}} {{layer}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "graphMode": "none",
        "colorMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có dữ liệu xác nhận",
          "decimals": 0,
          "displayName": "${__field.labels.dataset_id} ${__field.labels.entity} ${__field.labels.layer}"
        },
        "overrides": []
      }
    },
