  "templating": {
    "list": [
      {
        "name": "dataset",
        "label": "Nguồn dữ liệu",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "sentinel-prometheus"
        },
        "query": "label_values(sentinel_dataset_up, dataset_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
