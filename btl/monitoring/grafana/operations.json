{
  "uid": "sentinel-operations",
  "title": "Sentinel Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Last pipeline success",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-operations"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "time() - sentinel_ops_last_success_timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown"
        }
      }
    },
