# SentinelAI Environment Configuration
ENV=development
APP_NAME=SentinelAI
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=sentinel-client
KAFKA_GROUP_ID=sentinel-consumers

# Storage & Data Lake (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=sentinel-raw
MINIO_BUCKET_SILVER=sentinel-silver
MINIO_BUCKET_GOLD=sentinel-gold
LOCAL_DATA_DIR=./storage/datalake

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8

# Database (PostgreSQL / SQLite fallback)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpass
POSTGRES_DB=sentinel_dw
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./database/sentinel.db

# Elasticsearch Configuration
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX_PRODUCTS=sentinel-products
ELASTICSEARCH_INDEX_REVIEWS=sentinel-reviews

# Monitoring & Dashboard
STREAMLIT_PORT=8501
PROMETHEUS_PORT=9090
