{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PriceHistory",
  "type": "object",
  "properties": {
    "price_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "seller": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "price_id",
    "product_id",
    "price",
    "currency",
    "timestamp"
  ]
}